; ============================================================
; OmniRDP Service Configuration
; Location: C:\ProgramData\OmniRDP\config.ini
;
; This file was auto-generated on first install.
; Edit the [instance:Example] section below with your
; backend RDP server details, then restart the service.
;
; Plaintext passwords are automatically encrypted with DPAPI
; on first start. You can also use dpapi:<base64> values.
; ============================================================

[service]
; Log level: debug, info, warn, error
log_level = info

; Log directory (per-service subdirectory is auto-appended)
log_dir = C:\ProgramData\OmniRDP\logs

; Log rotation
log_max_size_mb = 10
log_max_files = 5

; Named pipe for tray app IPC
pipe_name = OmniRDP_ServicePipe

; Health monitoring
heartbeat_timeout_sec = 10
graceful_shutdown_sec = 10
health_poll_interval_sec = 2
instance_startup_delay_ms = 500

[instances]
; Comma-separated list of instance names.
; Each name must have a matching [instance:<name>] section.
; Leave empty to run idle with no instances.
names = Example

; ============================================================
; Instance: Example
; Edit these values with your backend RDP server details.
; ============================================================
[instance:Example]
enabled = true

; Backend VM connection (OmniRDP -> real backend VM)
backend.hostname = 192.168.1.10
backend.port = 3389
backend.username = localadmin
backend.password = password
backend.domain =
backend.connect_timeout_ms = 30000
; Experimental backend RDPEGFX decode-only path. Default off and independent of viewer GFX.
backend.gfx.decode_only_enabled = false
; Experimental backend RemoteFX candidate mode. Default off.
backend.gfx.rfx_enabled = false

; Optional RDS Connection Broker/session collection routing.
; RDP-file equivalents:
;   full address:s:rds-broker.domain.com
;   workspace id:s:rds-broker.domain.com
;   use redirection server name:i:1
;   loadbalanceinfo:s:tsv://MS Terminal Services Plugin.1.Marketing_Pool
;   alternate full address:s:rds-broker.domain.com
backend.rdp_file.workspace_id =
backend.rdp_file.use_redirection_server_name = false
backend.rdp_file.loadbalanceinfo =
backend.rdp_file.alternate_full_address =

; Backend security (OmniRDP -> backend VM)
backend.security.nla_enabled = true
backend.security.tls_enabled = true
backend.security.rdp_enabled = true
backend.security.server_authentication = true
backend.security.ignore_certificate = false

; Reconnect policy
reconnect.enabled = true
reconnect.max_attempts = 10
reconnect.initial_delay_ms = 1000
reconnect.max_delay_ms = 60000
reconnect.backoff_multiplier = 2.0

; Viewer listener/security (RDP clients connect to OmniRDP here)
viewer.bind_address = 127.0.0.1
viewer.port = 3390
viewer.max_viewers = 10
viewer.cert_path = C:\server.crt
viewer.key_path = C:\server.key
; Viewer-side security/auth is independent from backend.security.*.
; NLA validates credentials against the OmniRDP listener host/domain before
; OmniRDP's application logon callback runs. Backend-local accounts on another
; VM may be rejected by NLA before OmniRDP can compare backend credentials.
viewer.security.nla_enabled = true
viewer.security.tls_enabled = true
viewer.security.rdp_enabled = true
; none = accept viewer sessions without checking MSTSC credentials.
; backend_credentials = require MSTSC credentials to match backend.username/password
; in OmniRDP. In MSTSC, use the configured backend.username and backend.password.
; For backend-local accounts on another VM, set:
;   viewer.security.nla_enabled = false
;   viewer.security.tls_enabled = true
;   viewer.auth.mode = backend_credentials
; For local backend accounts, MSTSC domain may be empty, ., localhost, the
; backend computer name, or the value expected by the backend VM.
viewer.auth.mode = backend_credentials
viewer.slow_disconnect_enabled = true
viewer.slow_lag_interval_ms = 5000
viewer.slow_disconnect_after_ms = 30000
viewer.late_join_timeout_ms = 15000
viewer.late_join_refresh_deadline_ms = 5000
viewer.late_join_replay_max_frames = 4
viewer.throttle_max_updates_per_sec = 0
; Experimental viewer RDPEGFX path. Default off. Uses canonical framebuffer
; snapshots, not backend GFX.
viewer.gfx.enabled = false
; viewer.gfx.codec = uncompressed|rfx|clearcodec; compressed codecs require
; compatible RDPEGFX capability negotiation and multimon QA.
viewer.gfx.codec = uncompressed
; Experimental viewer RFX encoder threading. Default off.
viewer.gfx.rfx_threading_enabled = false
; Viewer RDPEGFX dirty pacing limits. Defaults preserve one in-flight frame
; and a 4 MiB in-flight payload cap.
viewer.gfx.dirty_max_in_flight_frames = 1
viewer.gfx.dirty_max_in_flight_bytes = 4194304
; Diagnostic only. Default off. When true, every viewer RDPEGFX incremental
; dirty update is sent as one full-frame dirty rect.
viewer.gfx.diagnostic.full_frame_dirty = false
; Default off. When enabled, slow classic viewers whose queued BitmapUpdate
; backlog exceeds either nonzero limit may have stale FIFO entries replaced
; with one latest framebuffer baseline.
viewer.classic_latest_state_enabled = false
viewer.classic_latest_state_max_queue_depth = 0
viewer.classic_latest_state_max_queue_bytes = 0

; Display
display.monitor_count = 1
display.monitor_width = 1920
display.monitor_height = 1080
display.color_depth = 32

; Codecs
codec.nscodec = true
codec.remote_fx = true
codec.graphics_pipeline = false
codec.h264 = false
codec.avc444 = false
codec.avc444v2 = false
codec.frame_acknowledge = 4

; Legacy compatibility security keys. Prefer backend.security.* for backend VM connection settings.
; Retained for older configs and may populate backend security if backend.security.* is absent.
security.tls_enabled = true
security.nla_enabled = true
security.tls_min_version = 1.2
security.server_authentication = true
security.ignore_certificate = false
